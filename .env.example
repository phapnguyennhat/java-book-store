POSTGRES_HOST=localhost
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
POSTGRES_PORT=5432
RABBITMQ_HOST=localhost
RABBITMQ_USER=bookstore
RABBITMQ_PASSWORD=bookstore
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# SMTP: Mailpit locally (UI on MAILPIT_UI_PORT). Real SMTP: set host/port, credentials, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Thoth <no-reply@thoth.local>
# Frontend base URL: verification links point at APP_URL/verify-email, the email logo at APP_URL/thoth-logo-mark.png
APP_URL=http://localhost:3000
JWT_SECRET=replace-me-with-output-of-openssl-rand-base64-48
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bookstore
# S3 (LocalStack locally; leave S3_ENDPOINT empty for real AWS)
LOCALSTACK_PORT=4566
S3_ENDPOINT=http://localhost:4566
S3_REGION=ap-southeast-1
S3_BUCKET=bookstore-private
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Swagger UI / OpenAPI docs (keep false in production)
API_DOCS_ENABLED=true
